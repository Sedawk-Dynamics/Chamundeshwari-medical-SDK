# Copy this file to `.env.local` and fill in the value.

# Web3Forms access key — powers both the contact form and the brochure form.
# 1. Go to https://web3forms.com, enter the inbox you want submissions sent to
# 2. The access key arrives by email — paste it below
# 3. Restart `npm run dev` (NEXT_PUBLIC_ vars are read at build time)
#
# Optional: in the Web3Forms dashboard you can point it at your own SMTP server
# so mails are delivered through your domain instead of theirs.
NEXT_PUBLIC_WEB3FORMS_KEY=
